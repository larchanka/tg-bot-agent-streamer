# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN="your_bot_token_here"

# Comma-separated list of allowed Telegram user IDs
ALLOWED_TELEGRAM_USER_IDS="123456789"

# Directory where Pi agent operates (defaults to ./workspace)
PI_WORKSPACE_DIR="./workspace"

# Optional: Default LLM model pattern
PI_MODEL=""

# Optional: Directory for persistent Pi session history files
PI_SESSION_DIR=".sessions"

# Optional: Stream throttle interval in ms (default: 1000)
STREAM_THROTTLE_MS="1000"

# Optional: Pi binary or command path (default: pi)
# PI_BIN_PATH="pi"
