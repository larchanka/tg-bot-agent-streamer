{
  "name": "tg-bot-agent-streamer",
  "version": "1.0.0",
  "description": "Telegram Bot bridge for Pi coding agent running in RPC mode with live streaming",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "telegram",
    "bot",
    "pi",
    "agent",
    "streaming",
    "rpc"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "@grammyjs/stream": "^1.1.0",
    "dotenv": "^18.0.9",
    "grammy": "^1.46.0",
    "telegramify-markdown": "^1.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
